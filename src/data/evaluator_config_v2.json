    },
    "G19": {
      "evaluators": [
        "E1_rules_redlines",
        "E6_process_behavior"
      ],
      "release_gate": "P1"
    },
    "G20": {
      "evaluators": [
        "E1_rules_redlines",
        "E2_facts_evidence",
